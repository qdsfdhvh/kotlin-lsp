#!/bin/sh
# Pre-commit hook for kotlin-lsp
# Install: cp .githooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -e

echo "🔍 Running pre-commit checks..."

# Use toolchain binaries directly (rustup proxy has PATH issues on this machine).
# Resolve dynamically so the hook also works with an isolated HOME (e.g.
# `HOME=/tmp/gatehome git commit` to skip the ~/.kotlin-lsp/sources cache
# during the integration tests).
if command -v rustup >/dev/null 2>&1; then
  RUSTUP_TOOLCHAIN="$(rustup which cargo | xargs dirname)"
else
  RUSTUP_TOOLCHAIN="$HOME/.rustup/toolchains/stable-aarch64-apple-darwin/bin"
fi
export PATH="$RUSTUP_TOOLCHAIN:$PATH"

# Check formatting (use cargo fmt to respect rustfmt.toml ignores)
echo "  📝 Checking formatting..."
cargo fmt -- --check || {
    echo "  ❌ Formatting check failed!"
    echo "     Run: cargo fmt"
    exit 1
}

# Run tests
echo "  🔍 Running cargo check..."
cargo check --quiet || {
    echo "  ❌ Cargo check failed!"
    exit 1
}
echo "  🧪 Running tests..."
cargo test --quiet || {
    echo "  ❌ Tests failed!"
    exit 1
}

# Run clippy
# --all-targets: also lint test code (plain `cargo clippy` skips #[cfg(test)]
# modules, which let a clippy warning slip through to CI on 2026-08-08)
echo "  🔎 Running clippy..."
cargo clippy --all-targets -- -D warnings || {
    echo "  ❌ Clippy found issues!"
    exit 1
}

echo "  ✅ All checks passed!"
